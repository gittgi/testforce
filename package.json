{
  "name": "salesforce-sandbox-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Salesforce Sandbox test workbench for Claude Code",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "sftw": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node dist/cli/main.js serve",
    "dev": "tsx src/cli/main.ts serve",
    "doctor": "tsx src/cli/main.ts doctor",
    "install:claude": "node scripts/install-testforce.mjs",
    "package:local": "node scripts/package.mjs",
    "verify:package": "node scripts/smoke-package.mjs",
    "schema": "tsx scripts/schema.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}

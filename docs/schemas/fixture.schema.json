{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "schemas": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "createable": {
            "type": "boolean"
          },
          "updateable": {
            "type": "boolean"
          },
          "deletable": {
            "type": "boolean"
          },
          "fields": {
            "minItems": 1,
            "maxItems": 2000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "precision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "scale": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "nillable": {
                  "type": "boolean"
                },
                "defaultedOnCreate": {
                  "type": "boolean"
                },
                "createable": {
                  "type": "boolean"
                },
                "updateable": {
                  "type": "boolean"
                },
                "referenceTo": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  }
                },
                "picklistValues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "restrictedPicklist": {
                  "type": "boolean"
                },
                "defaultValue": {
                  "$ref": "#/$defs/__schema0"
                },
                "defaultValueFormula": {
                  "type": "string"
                },
                "dependentPicklist": {
                  "type": "boolean"
                },
                "controllerName": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "calculated": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "type",
                "nillable",
                "defaultedOnCreate",
                "createable",
                "updateable"
              ],
              "additionalProperties": false
            }
          },
          "childRelationships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "childSObject": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "cascadeDelete": {
                  "type": "boolean"
                }
              },
              "required": [
                "childSObject",
                "field",
                "cascadeDelete"
              ],
              "additionalProperties": false
            }
          },
          "recordTypes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$"
                },
                "name": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "available"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "createable",
          "updateable",
          "deletable",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "isSandbox": {
          "type": "boolean"
        },
        "organizationType": {
          "type": "string",
          "minLength": 1
        },
        "verifiedScratchOrgId": {
          "type": "string",
          "pattern": "^00D[A-Za-z0-9]{12}(?:[A-Za-z0-9]{3})?$"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "records": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$"
        },
        "additionalProperties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      }
    },
    "jobs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$"
          },
          "status": {
            "type": "string",
            "enum": [
              "Holding",
              "Queued",
              "Preparing",
              "Processing",
              "Aborted",
              "Completed",
              "Failed"
            ]
          },
          "errors": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "processed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "parentJobId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{15}(?:[A-Za-z0-9]{3})?$"
          },
          "done": {
            "type": "boolean"
          },
          "extendedStatus": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "errors",
          "processed",
          "total",
          "done"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "category": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "maxLength": 50000
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "object",
          "category",
          "detail",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "schemas",
    "records",
    "jobs",
    "constraints"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
